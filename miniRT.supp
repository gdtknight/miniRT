# miniRT Valgrind Suppression File
# Suppresses "still reachable" leaks from X11, XCB, Xext, and MiniLibX
# that cannot be freed by user code.

# === X11 (libX11) ===

{
   x11_XOpenDisplay
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:XOpenDisplay
   ...
}

{
   x11_XInternAtom
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:XInternAtom
   ...
}

{
   x11_XCreateGC
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:XCreateGC
   ...
}

{
   x11_ConnectXCB
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_XConnectXCB
   ...
}

{
   x11_XEnq_events
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_XEnq
   ...
}

{
   x11_XReadEvents
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_XReadEvents
   ...
}

{
   x11_XReply
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_XReply
   ...
}

{
   x11_PollfdCacheInit
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_XPollfdCacheInit
   ...
}

